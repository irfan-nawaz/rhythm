# Copy to .env for local development. Every value here is a local default.
# In production, set real environment variables from a secret store and never
# ship a .env file (it is only read when NODE_ENV is not "production").

NODE_ENV=development
LOG_LEVEL=info

# ---- API --------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# The public URL people open. Used in email links and webhook payloads.
APP_URL=http://localhost:3000
# Send the session cookie over HTTPS only. Set true in every real environment.
COOKIE_SECURE=false
# How many proxies sit in front of the API (1 behind one load balancer), or
# their addresses. Rate limits and logs use the client IP this produces.
TRUST_PROXY=false
SESSION_TTL_DAYS=30
# Requests per minute, per signed-in user (per IP when signed out).
RATE_LIMIT_MAX=300
# Sign-in and sign-up attempts per minute, per IP.
RATE_LIMIT_AUTH_MAX=10

# ---- Data stores ------------------------------------------------------------
DATABASE_URL=postgres://rhythm:rhythm@localhost:5432/rhythm
# Connections per process. Total = this x every API, worker and scheduler process.
DB_POOL_MAX=10
# Prepared statements. Set false behind PgBouncer in transaction mode.
DB_PREPARE=true
# Cache: Valkey or Redis with allkeys-lru and no persistence.
CACHE_URL=redis://localhost:6379
# Queue: a separate Valkey or Redis with noeviction and AOF persistence.
QUEUE_URL=redis://localhost:6380

# ---- Notifications ----------------------------------------------------------
# smtp://user:pass@host:port for a real server, "log" to print emails to the
# log, or leave it out to turn email off. Mailpit from compose.yaml:
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Rhythm <no-reply@rhythm.local>
# Web Push keys: run `npm run vapid:keys` and paste the pair here. Without
# them, push is off and the rest of the app works. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@rhythm.local
# Allow webhooks to private addresses (a Home Assistant on your LAN).
# Defaults to true outside production and false in production.
# WEBHOOK_ALLOW_PRIVATE=false

# ---- Worker and scheduler ---------------------------------------------------
WORKER_CONCURRENCY=10
SCHEDULER_INTERVAL_MS=30000
SCHEDULER_BATCH_SIZE=500
# Reminders older than this are skipped rather than sent late.
NOTIFY_MAX_LATENESS_MINUTES=180

# ---- Operations -------------------------------------------------------------
# Prometheus metrics and /healthz, on a port of their own.
# Defaults: api 9464, worker 9465, scheduler 9466.
# METRICS_PORT=9464
# How long the API keeps serving after SIGTERM while readiness fails, so the
# load balancer stops sending traffic first. Defaults: 5000 in production, 0 otherwise.
# SHUTDOWN_DELAY_MS=5000
