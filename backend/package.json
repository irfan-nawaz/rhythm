{
  "name": "rhythm-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@node-rs/argon2": "^2.2.2",
    "@prometheus-io/client": "^0.16.1",
    "bullmq": "^6.7.7",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.7",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "description": "Rhythm backend: API, scheduler and worker",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "npm run clean && nest build && concurrently -k -n build,api,worker,scheduler -c gray,blue,magenta,green \"nest build --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist/api/main.js\" \"node --watch --watch-preserve-output dist/worker/main.js\" \"node --watch --watch-preserve-output dist/scheduler/main.js\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && nest build",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "start:scheduler": "node dist/scheduler/main.js",
    "start:migrate": "node dist/scripts/migrate.js",
    "start:seed": "node dist/scripts/seed.js",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:demo": "tsx src/scripts/seed.ts --demo",
    "vapid:keys": "web-push generate-vapid-keys",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  }
}
