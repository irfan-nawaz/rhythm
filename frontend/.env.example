# Where the Next.js server reaches the API over the private network.
#
# Two places read it, at different times:
# - server components (src/lib/server-api.ts) read it on every request;
# - the /api/* rewrite in next.config.ts is fixed when `next build` runs.
# So set it when building the image too, or route /api/* to the API at the
# load balancer and let the rewrite go unused. See docs/architecture.md.
API_INTERNAL_URL=http://localhost:4000
